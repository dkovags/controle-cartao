rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function email() {
      return request.auth != null && request.auth.token.email_verified == true
        ? request.auth.token.email : '';
    }
    function isAdmin()  { return email() == 'kovags@gmail.com'; }
    function isEditor() { return email() in ['kelianeserra@gmail.com']; }
    function isViewer() { return email() in []; }

    // data/main = produção, data/homolog = homologação
    match /data/{docId} {
      allow read:  if docId in ['main', 'homolog'] && (isAdmin() || isEditor() || isViewer());
      allow write: if docId in ['main', 'homolog'] && (isAdmin() || isEditor());

      // Comprovantes anexados (metadados) e suas partes (conteúdo em base64)
      match /anexos/{aid} {
        allow read:   if isAdmin() || isEditor() || isViewer();
        allow create: if isAdmin() || isEditor();
        allow delete: if isAdmin();
        match /partes/{n} {
          allow read:   if isAdmin() || isEditor() || isViewer();
          allow create: if isAdmin() || isEditor();
          allow delete: if isAdmin();
        }
      }
    }

    // Qualquer outro caminho: bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
